{
  "version": 2,
  "project": "harness",
  "targets": {
    "frontend": null,
    "backend": "node"
  },
  "moduleMap": {
    "plugins": ".opencode/plugins",
    "rules": ".agents/rules",
    "schemas": ".agents/schemas"
  },
  "commands": {
    "suiteFull": "node --test \".opencode/plugins/__tests__/*.spec.mjs\" && node --test \"scripts/__tests__/*.spec.mjs\" && node scripts/static-checks.mjs && node scripts/sdd-checks.mjs && node scripts/vendor-skills.mjs --check",
    "unit": "node --test \".opencode/plugins/__tests__/*.spec.mjs\""
  },
  "e2e": { "baseUrl": null, "steps": [], "browserRequired": false, "skipPolicy": "n/a-explicit" },
  "infra": {
    "composeFile": null,
    "ports": {
      "backend": null,
      "frontend": null
    }
  },
  "mcp": {
    "required": ["chrome-devtools"]
  },
  "protectedPaths": [
    ".opencode/plugins/**",
    ".opencode/plugins/__tests__/**",
    ".agents/rules/**",
    ".agents/schemas/**",
    ".agents/agents/**",
    ".agents/skills/**",
    ".github/workflows/**",
    ".githooks/**",
    ".codex/**",
    ".codex/harness-state.json",
    "opencode.json",
    "harness.config.json"
  ],
  "gates": {
    "picco": "enforce",
    "evidence": "enforce",
    "hitlBatch": "enforce"
  },
  "contraproveTimeoutMs": 900000,
  "evidence": {
    "path": "harness/",
    "schema": ".agents/schemas/harness-report.schema.json"
  }
}
