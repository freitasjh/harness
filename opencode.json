{
  "$schema": "https://opencode.ai/config.json",
   "$comment": "Dual-runtime config (opencode v1+v2 migration, PL-05): v2 keys (plugins, permissions, agents system) win when both shapes are present; v1 keys (plugin, permission task, agent prompt) are the fallback. Removal of v1 keys is out of scope. Plugins and config load at boot — restart the runtime to reload.",
  "plugin": ["./.opencode/plugins/gate.js", "./.opencode/plugins/harness-validator.js", "./.opencode/plugins/hitl-guardrail.js"],
  "plugins": [{ "id": "harness-gate", "path": "./.opencode/plugins/gate.js" }, { "id": "harness-validator", "path": "./.opencode/plugins/harness-validator.js" }, { "id": "hitl-guardrail", "path": "./.opencode/plugins/hitl-guardrail.js" }],
  "instructions": [
    ".agents/rules/*.md"
  ],
  "permission": {
    "task": "ask"
  },
  "permissions": {
    "subagent": "ask",
    "shell": "ask"
  },
   "agent": {
     "orchestrator": {
      "mode": "primary",
      "prompt": "{file:./.agents/agents/orchestrator/AGENT.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    },
    "developer-engineer": {
      "mode": "subagent",
      "prompt": "{file:./.agents/agents/developer-engineer/AGENT.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "codebase-analyzer": {
      "mode": "subagent",
      "prompt": "{file:./.agents/agents/codebase-analyzer/AGENT.md}",
      "tools": {
        "write": true,
        "edit": false,
        "bash": true
      }
    },
    "product-manager": {
